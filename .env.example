# Use a restricted API key (rk_) with only the permissions this app needs.
# Do not commit live or test keys. Store them in the host secrets vault.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

SESSION_SECRET=replace-with-a-long-random-string
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000

# Local UI only, and only when STRIPE_SECRET_KEY is unset. Never enable in production.
# STRIPE_SIMULATE=1
