# Restricted key (rk_) for the Schedi platform account. Do not commit a real key.
# Needed permissions: Accounts v2 write/read, Checkout Sessions, Customers,
# Products, Prices, Subscriptions, Account Sessions, and webhook signatures.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Platform destination ("Your account"): owner subscriptions.
STRIPE_WEBHOOK_SECRET=
# Connected-account destination: client card charges. Same URL, different secret.
STRIPE_CONNECT_WEBHOOK_SECRET=
# Shared with the booking worker. The Connect webhook posts a paid public
# booking here so the owner dashboard can show Card with the amount.
SCHEDI_CONNECT_PAID_SECRET=
# SCHEDI_CONNECT_PAID_URL=https://schedi.app/billing/connect-booking-paid

# Optional. When unset, Schedi creates Starter ($29/mo) and Pro ($49/mo)
# prices on the platform account.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

SESSION_SECRET=
SCHEDI_DB_PATH=data/schedi.sqlite
# Demo businesses seed outside production. Set to 1 to seed anyway, or 0 to skip.
# SCHEDI_SEED=0
