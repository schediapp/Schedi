{
  // Preview worker for schedi-web. Same script as production, no schedi.app routes.
  // Deploy: npx wrangler deploy --config wrangler.preview.jsonc
  // That matches `npx wrangler deploy --config wrangler.jsonc --env preview`.
  //
  // Logos go to schedi-logos-preview, not the production bucket schedi-logos.
  // Create it before deploying this file:
  //   npx wrangler r2 bucket create schedi-logos-preview
  // Safe fallback: delete the r2_buckets block if the bucket does not exist yet.
  // The site still serves. Logo upload returns logo_storage_unconfigured.
  // This config does not bind AUTH_KV. That namespace holds live agency sessions.
  // Without it, logo upload fails closed (session_required) and /hq stays on the login screen.
  "name": "schedi-web-preview",
  "compatibility_date": "2026-10-13",
  "main": "worker/index.ts",
  "workers_dev": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "siteforge-97699"
  },
  "kv_namespaces": [],
  "r2_buckets": [
    {
      "binding": "LOGO_BUCKET",
      "bucket_name": "schedi-logos-preview"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "routes": []
}
