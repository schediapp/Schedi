{
  // Public site worker for schedi.app. Marketing HTML is rendered in the script.
  // Git's site/ is the SPA shell (index.html) only. Logos, help videos, favicon,
  // manifests, and _headers stay in the deploy directory and are copied in beside
  // that shell at deploy time. See README. /api/* and /billing/* stay on their
  // more specific workers.
  "name": "schedi-web",
  "compatibility_date": "2026-10-13",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "siteforge-97699"
  },
  "kv_namespaces": [
    {
      "binding": "AUTH_KV",
      "id": "d53378ec0cfb4d089d73add2ff01c62d"
    }
  ],
  // Business logos. Create the bucket before the next production deploy:
  //   npx wrangler r2 bucket create schedi-logos
  // The worker serves files at https://schedi.app/logos/{tenantId}?v=...
  // No LOGO_PUBLIC_BASE and no public r2.dev hostname.
  "r2_buckets": [
    {
      "binding": "LOGO_BUCKET",
      "bucket_name": "schedi-logos"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  // Booking-page visits. Created on the first writeDataPoint after deploy.
  // No separate create command. The email worker reads this dataset with the
  // SQL API (secrets ANALYTICS_API_TOKEN and CF_ACCOUNT_ID). Not AUTH_KV.
  "analytics_engine_datasets": [
    {
      "binding": "PAGE_VISITS",
      "dataset": "schedi_page_visits"
    }
  ],
  "routes": [
    { "pattern": "schedi.app/*", "zone_name": "schedi.app" },
    { "pattern": "www.schedi.app/*", "zone_name": "schedi.app" }
  ],
  "env": {
    "preview": {
      "name": "schedi-web-preview",
      "workers_dev": true,
      "routes": [],
      "vars": {
        "FIREBASE_PROJECT_ID": "siteforge-97699"
      },
      // Do not inherit the production visit dataset. Preview hosts are not counted.
      "analytics_engine_datasets": [],
      // Do not inherit the production AUTH_KV. That namespace holds live agency
      // sessions. There is no separate preview namespace, so /hq cannot store a
      // session and stays on the login screen. Never add INDEXNOW_* or
      // BING_SITE_VERIFICATION to this environment.
      "kv_namespaces": [],
      // Own bucket so a preview upload cannot write production logos.
      // Create it before the next preview deploy:
      //   npx wrangler r2 bucket create schedi-logos-preview
      // If that bucket does not exist yet, delete this r2_buckets block.
      // The preview site still serves, and upload returns logo_storage_unconfigured.
      // Preview has no AUTH_KV, so a real owner session cannot be checked here.
      // Upload then fails closed. Demo mode does not upload.
      "r2_buckets": [
        {
          "binding": "LOGO_BUCKET",
          "bucket_name": "schedi-logos-preview"
        }
      ]
    }
  }
}
