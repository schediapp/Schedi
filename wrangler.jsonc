{
  // Public site worker for schedi.app. Marketing HTML is rendered in the script.
  // The SPA shell and existing files (logos, help videos, icons) are static assets.
  // site/ currently contains the app shell only. Do not deploy over production
  // until the live asset bucket (logos, help videos, favicon, manifest) is in site/.
  // /api/* and /billing/* stay on their more specific workers.
  "name": "schedi-web",
  "compatibility_date": "2026-10-13",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "siteforge-97699"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
