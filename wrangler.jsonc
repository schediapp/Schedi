{
  // Public site worker. Keep existing /api/* and /billing/* worker routes;
  // those are more specific and must stay in front of this script.
  "name": "schedi-web",
  "compatibility_date": "2026-10-07",
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Missing paths must not turn into index.html. src/index.js serves the
    // SPA shell for app routes and refuses that fallback for crawler files.
    "not_found_handling": "none",
    "html_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "siteforge-97699"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
